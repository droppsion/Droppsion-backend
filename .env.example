# ==============================================================================
# NovaTrend Backend Production Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# URLs & Allowed Cross-Origin Origins (CORS)
CLIENT_URL=https://your-storefront-domain.vercel.app
ADMIN_URL=https://your-admin-domain.vercel.app
ALLOWED_ORIGINS=https://your-storefront-domain.vercel.app,https://your-admin-domain.vercel.app

# JSON Web Token Secret (Generate a strong 32+ char random key in production)
JWT_SECRET=production-secret-dropship-key-change-this-in-production

# MongoDB Production Connection String (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/novatrend?retryWrites=true&w=majority
